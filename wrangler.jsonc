// Tells Cloudflare how to build and deploy this project.
// (No secrets here — the OpenAI key is stored in the Cloudflare dashboard.)
{
  // Must match the Worker name in your Cloudflare dashboard
  "name": "08-prj-loreal-chatbot",
  // The Worker code that handles /api requests
  "main": "RESOURCE_cloudflare-worker.js",
  "compatibility_date": "2025-09-01",
  // Give the site a public URL: 08-prj-loreal-chatbot.<subdomain>.workers.dev
  "workers_dev": true,
  // Keep variables added in the Cloudflare dashboard when a new build deploys
  "keep_vars": true,
  // Before each deploy: if the Cloudflare build has an OPENAI_API_KEY variable,
  // copy it into the Worker as an encrypted secret. (The key itself is never in this repo.)
  "build": {
    "command": "if [ -n \"$OPENAI_API_KEY\" ]; then echo \"$OPENAI_API_KEY\" | npx wrangler secret put OPENAI_API_KEY; else echo 'No OPENAI_API_KEY build variable found'; fi"
  },
  // Serve the website files (index.html, style.css, script.js, img/) from this folder
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  }
}
